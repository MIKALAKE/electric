{
  "name": "alcoolympics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --port 3215",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "precommit": "lint-staged",
    "preview": "vite preview",
    "prepare": "husky",
    "postinstall": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.5",
    "dayjs": "1.11.13",
    "eslint-plugin-react": "7.37.5",
    "i18next": "25.1.1",
    "lint-staged": "16.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "7.6.0",
    "react-router-dom": "7.6.0",
    "tailwindcss": "4.1.5",
    "yarn": "1.22.22"
  },
  "devDependencies": {
    "@eslint/js": "9.25.0",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.25.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "vite": "7.0.4"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix --report-unused-disable-directives --max-warnings 0"
    ],
    "**/*.{css,js,jsx,ts,tsx}": [
      "prettier --write"
    ]
  }
}
